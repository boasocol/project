 645:../../../../library/CMSIS/Include/core_cm0plus.h ****  */
 646:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 647:../../../../library/CMSIS/Include/core_cm0plus.h **** /* Memory mapping of Core Hardware */
 648:../../../../library/CMSIS/Include/core_cm0plus.h **** #define SCS_BASE            (0xE000E000UL)                            /*!< System Control Space Bas
 649:../../../../library/CMSIS/Include/core_cm0plus.h **** #define SysTick_BASE        (SCS_BASE +  0x0010UL)                    /*!< SysTick Base Address */
 650:../../../../library/CMSIS/Include/core_cm0plus.h **** #define NVIC_BASE           (SCS_BASE +  0x0100UL)                    /*!< NVIC Base Address */
 651:../../../../library/CMSIS/Include/core_cm0plus.h **** #define SCB_BASE            (SCS_BASE +  0x0D00UL)                    /*!< System Control Block Bas
