 604:../../../../library/CMSIS/Include/core_cm0plus.h **** /**
 605:../../../../library/CMSIS/Include/core_cm0plus.h ****   \ingroup  CMSIS_core_register
 606:../../../../library/CMSIS/Include/core_cm0plus.h ****   \defgroup CMSIS_CoreDebug       Core Debug Registers (CoreDebug)
 607:../../../../library/CMSIS/Include/core_cm0plus.h ****   \brief    Cortex-M0+ Core Debug Registers (DCB registers, SHCSR, and DFSR) are only accessible ov
 608:../../../../library/CMSIS/Include/core_cm0plus.h ****             Therefore they are not covered by the Cortex-M0+ header file.
 609:../../../../library/CMSIS/Include/core_cm0plus.h ****   @{
 610:../../../../library/CMSIS/Include/core_cm0plus.h ****  */
 611:../../../../library/CMSIS/Include/core_cm0plus.h **** /*@} end of group CMSIS_CoreDebug */
