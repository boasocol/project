 205:../../../../library/CMSIS/Include/cmsis_gcc.h **** /* ##########################  Core Instruction Access  ######################### */
 206:../../../../library/CMSIS/Include/cmsis_gcc.h **** /** \defgroup CMSIS_Core_InstructionInterface CMSIS Core Instruction Interface
 207:../../../../library/CMSIS/Include/cmsis_gcc.h ****   Access to dedicated instructions
 208:../../../../library/CMSIS/Include/cmsis_gcc.h ****   @{
 209:../../../../library/CMSIS/Include/cmsis_gcc.h **** */
 210:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 211:../../../../library/CMSIS/Include/cmsis_gcc.h **** /* Define macros for porting to both thumb1 and thumb2.
 212:../../../../library/CMSIS/Include/cmsis_gcc.h ****  * For thumb1, use low register (r0-r7), specified by constraint "l"
 213:../../../../library/CMSIS/Include/cmsis_gcc.h ****  * Otherwise, use general registers, specified by constraint "r" */
 214:../../../../library/CMSIS/Include/cmsis_gcc.h **** #if defined (__thumb__) && !defined (__thumb2__)
 215:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __CMSIS_GCC_OUT_REG(r) "=l" (r)
 216:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __CMSIS_GCC_RW_REG(r) "+l" (r)
 217:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __CMSIS_GCC_USE_REG(r) "l" (r)
 218:../../../../library/CMSIS/Include/cmsis_gcc.h **** #else
 219:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __CMSIS_GCC_OUT_REG(r) "=r" (r)
 220:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __CMSIS_GCC_RW_REG(r) "+r" (r)
 221:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __CMSIS_GCC_USE_REG(r) "r" (r)
 222:../../../../library/CMSIS/Include/cmsis_gcc.h **** #endif
 223:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 224:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 225:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   No Operation
 226:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details No Operation does nothing. This instruction can be used for code alignment purposes.
 227:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 228:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __NOP()                             __ASM volatile ("nop")
 229:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 230:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 231:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Wait For Interrupt
 232:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Wait For Interrupt is a hint instruction that suspends execution until one of a number o
 233:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 234:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __WFI()                             __ASM volatile ("wfi":::"memory")
 235:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 236:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 237:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 238:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Wait For Event
 239:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Wait For Event is a hint instruction that permits the processor to enter
 240:../../../../library/CMSIS/Include/cmsis_gcc.h ****            a low-power state until one of a number of events occurs.
 241:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 242:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __WFE()                             __ASM volatile ("wfe":::"memory")
 243:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 244:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 245:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 246:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Send Event
 247:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Send Event is a hint instruction. It causes an event to be signaled to the CPU.
 248:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 249:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __SEV()                             __ASM volatile ("sev")
 250:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 251:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 252:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 253:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Instruction Synchronization Barrier
 254:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Instruction Synchronization Barrier flushes the pipeline in the processor,
 255:../../../../library/CMSIS/Include/cmsis_gcc.h ****            so that all instructions following the ISB are fetched from cache or memory,
 256:../../../../library/CMSIS/Include/cmsis_gcc.h ****            after the instruction has been completed.
 257:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 258:../../../../library/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE void __ISB(void)
 259:../../../../library/CMSIS/Include/cmsis_gcc.h **** {
 260:../../../../library/CMSIS/Include/cmsis_gcc.h ****   __ASM volatile ("isb 0xF":::"memory");
 261:../../../../library/CMSIS/Include/cmsis_gcc.h **** }
 262:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 263:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 264:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 265:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Data Synchronization Barrier
 266:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Acts as a special kind of Data Memory Barrier.
 267:../../../../library/CMSIS/Include/cmsis_gcc.h ****            It completes when all explicit memory accesses before this instruction complete.
 268:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 269:../../../../library/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE void __DSB(void)
 270:../../../../library/CMSIS/Include/cmsis_gcc.h **** {
 271:../../../../library/CMSIS/Include/cmsis_gcc.h ****   __ASM volatile ("dsb 0xF":::"memory");
 272:../../../../library/CMSIS/Include/cmsis_gcc.h **** }
 273:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 274:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 275:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 276:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Data Memory Barrier
 277:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Ensures the apparent order of the explicit memory operations before
 278:../../../../library/CMSIS/Include/cmsis_gcc.h ****            and after the instruction, without ensuring their completion.
 279:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 280:../../../../library/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE void __DMB(void)
 281:../../../../library/CMSIS/Include/cmsis_gcc.h **** {
 282:../../../../library/CMSIS/Include/cmsis_gcc.h ****   __ASM volatile ("dmb 0xF":::"memory");
 283:../../../../library/CMSIS/Include/cmsis_gcc.h **** }
 284:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 285:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 286:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 287:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Reverse byte order (32 bit)
 288:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Reverses the byte order in unsigned integer value. For example, 0x12345678 becomes 0x785
 289:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \param [in]    value  Value to reverse
 290:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \return               Reversed value
 291:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 292:../../../../library/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE uint32_t __REV(uint32_t value)
 293:../../../../library/CMSIS/Include/cmsis_gcc.h **** {
 294:../../../../library/CMSIS/Include/cmsis_gcc.h **** #if (__GNUC__ > 4) || (__GNUC__ == 4 && __GNUC_MINOR__ >= 5)
 295:../../../../library/CMSIS/Include/cmsis_gcc.h ****   return __builtin_bswap32(value);
 296:../../../../library/CMSIS/Include/cmsis_gcc.h **** #else
 297:../../../../library/CMSIS/Include/cmsis_gcc.h ****   uint32_t result;
 298:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 299:../../../../library/CMSIS/Include/cmsis_gcc.h ****   __ASM ("rev %0, %1" : __CMSIS_GCC_OUT_REG (result) : __CMSIS_GCC_USE_REG (value) );
 300:../../../../library/CMSIS/Include/cmsis_gcc.h ****   return result;
 301:../../../../library/CMSIS/Include/cmsis_gcc.h **** #endif
 302:../../../../library/CMSIS/Include/cmsis_gcc.h **** }
 303:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 304:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 305:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 306:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Reverse byte order (16 bit)
 307:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Reverses the byte order within each halfword of a word. For example, 0x12345678 becomes 
 308:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \param [in]    value  Value to reverse
 309:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \return               Reversed value
 310:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 311:../../../../library/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE uint32_t __REV16(uint32_t value)
 312:../../../../library/CMSIS/Include/cmsis_gcc.h **** {
 313:../../../../library/CMSIS/Include/cmsis_gcc.h ****   uint32_t result;
 314:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 315:../../../../library/CMSIS/Include/cmsis_gcc.h ****   __ASM ("rev16 %0, %1" : __CMSIS_GCC_OUT_REG (result) : __CMSIS_GCC_USE_REG (value) );
 316:../../../../library/CMSIS/Include/cmsis_gcc.h ****   return result;
 317:../../../../library/CMSIS/Include/cmsis_gcc.h **** }
 318:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 319:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 320:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 321:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Reverse byte order (16 bit)
 322:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Reverses the byte order in a 16-bit value and returns the signed 16-bit result. For exam
 323:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \param [in]    value  Value to reverse
 324:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \return               Reversed value
 325:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 326:../../../../library/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE int16_t __REVSH(int16_t value)
 327:../../../../library/CMSIS/Include/cmsis_gcc.h **** {
 328:../../../../library/CMSIS/Include/cmsis_gcc.h **** #if (__GNUC__ > 4) || (__GNUC__ == 4 && __GNUC_MINOR__ >= 8)
 329:../../../../library/CMSIS/Include/cmsis_gcc.h ****   return (int16_t)__builtin_bswap16(value);
 330:../../../../library/CMSIS/Include/cmsis_gcc.h **** #else
 331:../../../../library/CMSIS/Include/cmsis_gcc.h ****   int16_t result;
 332:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 333:../../../../library/CMSIS/Include/cmsis_gcc.h ****   __ASM ("revsh %0, %1" : __CMSIS_GCC_OUT_REG (result) : __CMSIS_GCC_USE_REG (value) );
 334:../../../../library/CMSIS/Include/cmsis_gcc.h ****   return result;
 335:../../../../library/CMSIS/Include/cmsis_gcc.h **** #endif
 336:../../../../library/CMSIS/Include/cmsis_gcc.h **** }
 337:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 338:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 339:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 340:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Rotate Right in unsigned value (32 bit)
 341:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Rotate Right (immediate) provides the value of the contents of a register rotated by a v
 342:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \param [in]    op1  Value to rotate
 343:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \param [in]    op2  Number of Bits to rotate
 344:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \return               Rotated value
 345:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 346:../../../../library/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE uint32_t __ROR(uint32_t op1, uint32_t op2)
 347:../../../../library/CMSIS/Include/cmsis_gcc.h **** {
 348:../../../../library/CMSIS/Include/cmsis_gcc.h ****   op2 %= 32U;
 349:../../../../library/CMSIS/Include/cmsis_gcc.h ****   if (op2 == 0U)
 350:../../../../library/CMSIS/Include/cmsis_gcc.h ****   {
 351:../../../../library/CMSIS/Include/cmsis_gcc.h ****     return op1;
 352:../../../../library/CMSIS/Include/cmsis_gcc.h ****   }
 353:../../../../library/CMSIS/Include/cmsis_gcc.h ****   return (op1 >> op2) | (op1 << (32U - op2));
 354:../../../../library/CMSIS/Include/cmsis_gcc.h **** }
 355:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 356:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 357:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 358:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Breakpoint
 359:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Causes the processor to enter Debug state.
 360:../../../../library/CMSIS/Include/cmsis_gcc.h ****            Debug tools can use this to investigate system state when the instruction at a particula
 361:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \param [in]    value  is ignored by the processor.
 362:../../../../library/CMSIS/Include/cmsis_gcc.h ****                  If required, a debugger can use it to store additional information about the break
 363:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 364:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __BKPT(value)                       __ASM volatile ("bkpt "#value)
 365:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 366:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 367:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 368:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Reverse bit order of value
 369:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Reverses the bit order of the given value.
 370:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \param [in]    value  Value to reverse
 371:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \return               Reversed value
 372:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 373:../../../../library/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE uint32_t __RBIT(uint32_t value)
 374:../../../../library/CMSIS/Include/cmsis_gcc.h **** {
 375:../../../../library/CMSIS/Include/cmsis_gcc.h ****   uint32_t result;
 376:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 377:../../../../library/CMSIS/Include/cmsis_gcc.h **** #if ((defined (__ARM_ARCH_7M__      ) && (__ARM_ARCH_7M__      == 1)) || \
 378:../../../../library/CMSIS/Include/cmsis_gcc.h ****      (defined (__ARM_ARCH_7EM__     ) && (__ARM_ARCH_7EM__     == 1)) || \
 379:../../../../library/CMSIS/Include/cmsis_gcc.h ****      (defined (__ARM_ARCH_8M_MAIN__ ) && (__ARM_ARCH_8M_MAIN__ == 1))    )
 380:../../../../library/CMSIS/Include/cmsis_gcc.h ****    __ASM ("rbit %0, %1" : "=r" (result) : "r" (value) );
 381:../../../../library/CMSIS/Include/cmsis_gcc.h **** #else
 382:../../../../library/CMSIS/Include/cmsis_gcc.h ****   uint32_t s = (4U /*sizeof(v)*/ * 8U) - 1U; /* extra shift needed at end */
 383:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 384:../../../../library/CMSIS/Include/cmsis_gcc.h ****   result = value;                      /* r will be reversed bits of v; first get LSB of v */
 385:../../../../library/CMSIS/Include/cmsis_gcc.h ****   for (value >>= 1U; value != 0U; value >>= 1U)
 386:../../../../library/CMSIS/Include/cmsis_gcc.h ****   {
 387:../../../../library/CMSIS/Include/cmsis_gcc.h ****     result <<= 1U;
 388:../../../../library/CMSIS/Include/cmsis_gcc.h ****     result |= value & 1U;
 389:../../../../library/CMSIS/Include/cmsis_gcc.h ****     s--;
 390:../../../../library/CMSIS/Include/cmsis_gcc.h ****   }
 391:../../../../library/CMSIS/Include/cmsis_gcc.h ****   result <<= s;                        /* shift when v's highest bits are zero */
 392:../../../../library/CMSIS/Include/cmsis_gcc.h **** #endif
 393:../../../../library/CMSIS/Include/cmsis_gcc.h ****   return result;
 394:../../../../library/CMSIS/Include/cmsis_gcc.h **** }
 395:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 396:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 397:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 398:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Count leading zeros
 399:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Counts the number of leading zeros of a data value.
 400:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \param [in]  value  Value to count the leading zeros
 401:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \return             number of leading zeros in value
 402:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 403:../../../../library/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE uint8_t __CLZ(uint32_t value)
 404:../../../../library/CMSIS/Include/cmsis_gcc.h **** {
 405:../../../../library/CMSIS/Include/cmsis_gcc.h ****   /* Even though __builtin_clz produces a CLZ instruction on ARM, formally
 406:../../../../library/CMSIS/Include/cmsis_gcc.h ****      __builtin_clz(0) is undefined behaviour, so handle this case specially.
 407:../../../../library/CMSIS/Include/cmsis_gcc.h ****      This guarantees ARM-compatible results if happening to compile on a non-ARM
 408:../../../../library/CMSIS/Include/cmsis_gcc.h ****      target, and ensures the compiler doesn't decide to activate any
 409:../../../../library/CMSIS/Include/cmsis_gcc.h ****      optimisations using the logic "value was passed to __builtin_clz, so it
 410:../../../../library/CMSIS/Include/cmsis_gcc.h ****      is non-zero".
 411:../../../../library/CMSIS/Include/cmsis_gcc.h ****      ARM GCC 7.3 and possibly earlier will optimise this test away, leaving a
 412:../../../../library/CMSIS/Include/cmsis_gcc.h ****      single CLZ instruction.
 413:../../../../library/CMSIS/Include/cmsis_gcc.h ****    */
 414:../../../../library/CMSIS/Include/cmsis_gcc.h ****   if (value == 0U)
