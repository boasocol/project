 761:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 762:../../../../library/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE uint8_t __LDAB(volatile uint8_t *ptr)
 763:../../../../library/CMSIS/Include/cmsis_gcc.h **** {
 764:../../../../library/CMSIS/Include/cmsis_gcc.h ****     uint32_t result;
