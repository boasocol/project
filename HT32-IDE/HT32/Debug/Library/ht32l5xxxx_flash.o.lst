 680:../../../../library/CMSIS/Include/cmsis_gcc.h **** {
 681:../../../../library/CMSIS/Include/cmsis_gcc.h ****    __ASM volatile ("strht %1, %0" : "=Q" (*ptr) : "r" ((uint32_t)value) );
 682:../../../../library/CMSIS/Include/cmsis_gcc.h **** }
