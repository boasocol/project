 700:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 701:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Signed Saturate
 702:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Saturates a signed value.
 703:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \param [in]  value  Value to be saturated
 704:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \param [in]    sat  Bit position to saturate to (1..32)
 705:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \return             Saturated value
 706:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 707:../../../../library/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE int32_t __SSAT(int32_t val, uint32_t sat)
 708:../../../../library/CMSIS/Include/cmsis_gcc.h **** {
 709:../../../../library/CMSIS/Include/cmsis_gcc.h ****   if ((sat >= 1U) && (sat <= 32U))
 710:../../../../library/CMSIS/Include/cmsis_gcc.h ****   {
 711:../../../../library/CMSIS/Include/cmsis_gcc.h ****     const int32_t max = (int32_t)((1U << (sat - 1U)) - 1U);
 712:../../../../library/CMSIS/Include/cmsis_gcc.h ****     const int32_t min = -1 - max ;
 713:../../../../library/CMSIS/Include/cmsis_gcc.h ****     if (val > max)
 714:../../../../library/CMSIS/Include/cmsis_gcc.h ****     {
 715:../../../../library/CMSIS/Include/cmsis_gcc.h ****       return max;
 716:../../../../library/CMSIS/Include/cmsis_gcc.h ****     }
 717:../../../../library/CMSIS/Include/cmsis_gcc.h ****     else if (val < min)
 718:../../../../library/CMSIS/Include/cmsis_gcc.h ****     {
 719:../../../../library/CMSIS/Include/cmsis_gcc.h ****       return min;
 720:../../../../library/CMSIS/Include/cmsis_gcc.h ****     }
 721:../../../../library/CMSIS/Include/cmsis_gcc.h ****   }
 722:../../../../library/CMSIS/Include/cmsis_gcc.h ****   return val;
 723:../../../../library/CMSIS/Include/cmsis_gcc.h **** }
 724:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 725:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 726:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Unsigned Saturate
 727:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Saturates an unsigned value.
 728:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \param [in]  value  Value to be saturated
 729:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \param [in]    sat  Bit position to saturate to (0..31)
 730:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \return             Saturated value
 731:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 732:../../../../library/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE uint32_t __USAT(int32_t val, uint32_t sat)
 733:../../../../library/CMSIS/Include/cmsis_gcc.h **** {
 734:../../../../library/CMSIS/Include/cmsis_gcc.h ****   if (sat <= 31U)
 735:../../../../library/CMSIS/Include/cmsis_gcc.h ****   {
 736:../../../../library/CMSIS/Include/cmsis_gcc.h ****     const uint32_t max = ((1U << sat) - 1U);
 737:../../../../library/CMSIS/Include/cmsis_gcc.h ****     if (val > (int32_t)max)
 738:../../../../library/CMSIS/Include/cmsis_gcc.h ****     {
 739:../../../../library/CMSIS/Include/cmsis_gcc.h ****       return max;
 740:../../../../library/CMSIS/Include/cmsis_gcc.h ****     }
 741:../../../../library/CMSIS/Include/cmsis_gcc.h ****     else if (val < 0)
 742:../../../../library/CMSIS/Include/cmsis_gcc.h ****     {
 743:../../../../library/CMSIS/Include/cmsis_gcc.h ****       return 0U;
 744:../../../../library/CMSIS/Include/cmsis_gcc.h ****     }
 745:../../../../library/CMSIS/Include/cmsis_gcc.h ****   }
 746:../../../../library/CMSIS/Include/cmsis_gcc.h ****   return (uint32_t)val;
 747:../../../../library/CMSIS/Include/cmsis_gcc.h **** }
 748:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
