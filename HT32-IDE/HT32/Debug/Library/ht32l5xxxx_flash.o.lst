 690:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 691:../../../../library/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE void __STRT(uint32_t value, volatile uint32_t *ptr)
 692:../../../../library/CMSIS/Include/cmsis_gcc.h **** {
 693:../../../../library/CMSIS/Include/cmsis_gcc.h ****    __ASM volatile ("strt %1, %0" : "=Q" (*ptr) : "r" (value) );
