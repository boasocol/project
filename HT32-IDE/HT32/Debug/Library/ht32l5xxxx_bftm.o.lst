 123:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 124:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 125:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Initializes data and bss sections
 126:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details This default implementations initialized all data and additional bss
 127:../../../../library/CMSIS/Include/cmsis_gcc.h ****            sections relying on .copy.table and .zero.table specified properly
 128:../../../../library/CMSIS/Include/cmsis_gcc.h ****            in the used linker script.
 129:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 130:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 131:../../../../library/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE __NO_RETURN void __cmsis_start(void)
 132:../../../../library/CMSIS/Include/cmsis_gcc.h **** {
 133:../../../../library/CMSIS/Include/cmsis_gcc.h ****   extern void _start(void) __NO_RETURN;
 134:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 135:../../../../library/CMSIS/Include/cmsis_gcc.h ****   typedef struct {
 136:../../../../library/CMSIS/Include/cmsis_gcc.h ****     uint32_t const* src;
 137:../../../../library/CMSIS/Include/cmsis_gcc.h ****     uint32_t* dest;
 138:../../../../library/CMSIS/Include/cmsis_gcc.h ****     uint32_t  wlen;
 139:../../../../library/CMSIS/Include/cmsis_gcc.h ****   } __copy_table_t;
 140:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 141:../../../../library/CMSIS/Include/cmsis_gcc.h ****   typedef struct {
 142:../../../../library/CMSIS/Include/cmsis_gcc.h ****     uint32_t* dest;
 143:../../../../library/CMSIS/Include/cmsis_gcc.h ****     uint32_t  wlen;
 144:../../../../library/CMSIS/Include/cmsis_gcc.h ****   } __zero_table_t;
 145:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 146:../../../../library/CMSIS/Include/cmsis_gcc.h ****   extern const __copy_table_t __copy_table_start__;
 147:../../../../library/CMSIS/Include/cmsis_gcc.h ****   extern const __copy_table_t __copy_table_end__;
 148:../../../../library/CMSIS/Include/cmsis_gcc.h ****   extern const __zero_table_t __zero_table_start__;
 149:../../../../library/CMSIS/Include/cmsis_gcc.h ****   extern const __zero_table_t __zero_table_end__;
 150:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 151:../../../../library/CMSIS/Include/cmsis_gcc.h ****   for (__copy_table_t const* pTable = &__copy_table_start__; pTable < &__copy_table_end__; ++pTable
 152:../../../../library/CMSIS/Include/cmsis_gcc.h ****     for(uint32_t i=0u; i<pTable->wlen; ++i) {
 153:../../../../library/CMSIS/Include/cmsis_gcc.h ****       pTable->dest[i] = pTable->src[i];
 154:../../../../library/CMSIS/Include/cmsis_gcc.h ****     }
 155:../../../../library/CMSIS/Include/cmsis_gcc.h ****   }
 156:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 157:../../../../library/CMSIS/Include/cmsis_gcc.h ****   for (__zero_table_t const* pTable = &__zero_table_start__; pTable < &__zero_table_end__; ++pTable
 158:../../../../library/CMSIS/Include/cmsis_gcc.h ****     for(uint32_t i=0u; i<pTable->wlen; ++i) {
 159:../../../../library/CMSIS/Include/cmsis_gcc.h ****       pTable->dest[i] = 0u;
 160:../../../../library/CMSIS/Include/cmsis_gcc.h ****     }
 161:../../../../library/CMSIS/Include/cmsis_gcc.h ****   }
 162:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 163:../../../../library/CMSIS/Include/cmsis_gcc.h ****   _start();
 164:../../../../library/CMSIS/Include/cmsis_gcc.h **** }
