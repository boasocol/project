 205:../../../../library/CMSIS/Include/cmsis_gcc.h **** /* ##########################  Core Instruction Access  ######################### */
 206:../../../../library/CMSIS/Include/cmsis_gcc.h **** /** \defgroup CMSIS_Core_InstructionInterface CMSIS Core Instruction Interface
 207:../../../../library/CMSIS/Include/cmsis_gcc.h ****   Access to dedicated instructions
 208:../../../../library/CMSIS/Include/cmsis_gcc.h ****   @{
 209:../../../../library/CMSIS/Include/cmsis_gcc.h **** */
 210:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 211:../../../../library/CMSIS/Include/cmsis_gcc.h **** /* Define macros for porting to both thumb1 and thumb2.
 212:../../../../library/CMSIS/Include/cmsis_gcc.h ****  * For thumb1, use low register (r0-r7), specified by constraint "l"
 213:../../../../library/CMSIS/Include/cmsis_gcc.h ****  * Otherwise, use general registers, specified by constraint "r" */
 214:../../../../library/CMSIS/Include/cmsis_gcc.h **** #if defined (__thumb__) && !defined (__thumb2__)
 215:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __CMSIS_GCC_OUT_REG(r) "=l" (r)
 216:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __CMSIS_GCC_RW_REG(r) "+l" (r)
 217:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __CMSIS_GCC_USE_REG(r) "l" (r)
 218:../../../../library/CMSIS/Include/cmsis_gcc.h **** #else
 219:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __CMSIS_GCC_OUT_REG(r) "=r" (r)
 220:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __CMSIS_GCC_RW_REG(r) "+r" (r)
 221:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __CMSIS_GCC_USE_REG(r) "r" (r)
 222:../../../../library/CMSIS/Include/cmsis_gcc.h **** #endif
 223:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 224:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 225:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   No Operation
 226:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details No Operation does nothing. This instruction can be used for code alignment purposes.
 227:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 228:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __NOP()                             __ASM volatile ("nop")
 229:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 230:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 231:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Wait For Interrupt
 232:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Wait For Interrupt is a hint instruction that suspends execution until one of a number o
 233:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 234:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __WFI()                             __ASM volatile ("wfi":::"memory")
 235:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 236:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 237:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 238:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Wait For Event
 239:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Wait For Event is a hint instruction that permits the processor to enter
 240:../../../../library/CMSIS/Include/cmsis_gcc.h ****            a low-power state until one of a number of events occurs.
 241:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 242:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __WFE()                             __ASM volatile ("wfe":::"memory")
 243:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 244:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
 245:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 246:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Send Event
 247:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Send Event is a hint instruction. It causes an event to be signaled to the CPU.
 248:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
 249:../../../../library/CMSIS/Include/cmsis_gcc.h **** #define __SEV()                             __ASM volatile ("sev")
 250:../../../../library/CMSIS/Include/cmsis_gcc.h **** 
