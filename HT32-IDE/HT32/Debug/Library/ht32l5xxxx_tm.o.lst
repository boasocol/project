 252:../../../../library/CMSIS/Include/cmsis_gcc.h **** /**
 253:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \brief   Instruction Synchronization Barrier
 254:../../../../library/CMSIS/Include/cmsis_gcc.h ****   \details Instruction Synchronization Barrier flushes the pipeline in the processor,
 255:../../../../library/CMSIS/Include/cmsis_gcc.h ****            so that all instructions following the ISB are fetched from cache or memory,
 256:../../../../library/CMSIS/Include/cmsis_gcc.h ****            after the instruction has been completed.
 257:../../../../library/CMSIS/Include/cmsis_gcc.h ****  */
