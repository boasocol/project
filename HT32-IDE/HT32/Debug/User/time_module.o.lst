 735:../../../../library/CMSIS/Include/core_cm0plus.h **** /**
 736:../../../../library/CMSIS/Include/core_cm0plus.h ****   \brief   Enable Interrupt
 737:../../../../library/CMSIS/Include/core_cm0plus.h ****   \details Enables a device specific interrupt in the NVIC interrupt controller.
 738:../../../../library/CMSIS/Include/core_cm0plus.h ****   \param [in]      IRQn  Device specific interrupt number.
 739:../../../../library/CMSIS/Include/core_cm0plus.h ****   \note    IRQn must not be negative.
 740:../../../../library/CMSIS/Include/core_cm0plus.h ****  */
 741:../../../../library/CMSIS/Include/core_cm0plus.h **** __STATIC_INLINE void __NVIC_EnableIRQ(IRQn_Type IRQn)
 742:../../../../library/CMSIS/Include/core_cm0plus.h **** {
 743:../../../../library/CMSIS/Include/core_cm0plus.h ****   if ((int32_t)(IRQn) >= 0)
 744:../../../../library/CMSIS/Include/core_cm0plus.h ****   {
 745:../../../../library/CMSIS/Include/core_cm0plus.h ****     __COMPILER_BARRIER();
 746:../../../../library/CMSIS/Include/core_cm0plus.h ****     NVIC->ISER[0U] = (uint32_t)(1UL << (((uint32_t)IRQn) & 0x1FUL));
 747:../../../../library/CMSIS/Include/core_cm0plus.h ****     __COMPILER_BARRIER();
 748:../../../../library/CMSIS/Include/core_cm0plus.h ****   }
 749:../../../../library/CMSIS/Include/core_cm0plus.h **** }
 750:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 751:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 752:../../../../library/CMSIS/Include/core_cm0plus.h **** /**
 753:../../../../library/CMSIS/Include/core_cm0plus.h ****   \brief   Get Interrupt Enable status
 754:../../../../library/CMSIS/Include/core_cm0plus.h ****   \details Returns a device specific interrupt enable status from the NVIC interrupt controller.
 755:../../../../library/CMSIS/Include/core_cm0plus.h ****   \param [in]      IRQn  Device specific interrupt number.
 756:../../../../library/CMSIS/Include/core_cm0plus.h ****   \return             0  Interrupt is not enabled.
 757:../../../../library/CMSIS/Include/core_cm0plus.h ****   \return             1  Interrupt is enabled.
 758:../../../../library/CMSIS/Include/core_cm0plus.h ****   \note    IRQn must not be negative.
 759:../../../../library/CMSIS/Include/core_cm0plus.h ****  */
