 207:../../../../library/CMSIS/Include/core_cm0plus.h **** /**
 208:../../../../library/CMSIS/Include/core_cm0plus.h ****   \brief  Union type to access the Application Program Status Register (APSR).
 209:../../../../library/CMSIS/Include/core_cm0plus.h ****  */
 210:../../../../library/CMSIS/Include/core_cm0plus.h **** typedef union
 211:../../../../library/CMSIS/Include/core_cm0plus.h **** {
 212:../../../../library/CMSIS/Include/core_cm0plus.h ****   struct
 213:../../../../library/CMSIS/Include/core_cm0plus.h ****   {
 214:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t _reserved0:28;              /*!< bit:  0..27  Reserved */
 215:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t V:1;                        /*!< bit:     28  Overflow condition code flag */
 216:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t C:1;                        /*!< bit:     29  Carry condition code flag */
 217:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t Z:1;                        /*!< bit:     30  Zero condition code flag */
 218:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t N:1;                        /*!< bit:     31  Negative condition code flag */
 219:../../../../library/CMSIS/Include/core_cm0plus.h ****   } b;                                   /*!< Structure used for bit  access */
 220:../../../../library/CMSIS/Include/core_cm0plus.h ****   uint32_t w;                            /*!< Type      used for word access */
 221:../../../../library/CMSIS/Include/core_cm0plus.h **** } APSR_Type;
 222:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 223:../../../../library/CMSIS/Include/core_cm0plus.h **** /* APSR Register Definitions */
 224:../../../../library/CMSIS/Include/core_cm0plus.h **** #define APSR_N_Pos                         31U                                            /*!< APSR
 225:../../../../library/CMSIS/Include/core_cm0plus.h **** #define APSR_N_Msk                         (1UL << APSR_N_Pos)                            /*!< APSR
 226:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 227:../../../../library/CMSIS/Include/core_cm0plus.h **** #define APSR_Z_Pos                         30U                                            /*!< APSR
 228:../../../../library/CMSIS/Include/core_cm0plus.h **** #define APSR_Z_Msk                         (1UL << APSR_Z_Pos)                            /*!< APSR
 229:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 230:../../../../library/CMSIS/Include/core_cm0plus.h **** #define APSR_C_Pos                         29U                                            /*!< APSR
 231:../../../../library/CMSIS/Include/core_cm0plus.h **** #define APSR_C_Msk                         (1UL << APSR_C_Pos)                            /*!< APSR
 232:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 233:../../../../library/CMSIS/Include/core_cm0plus.h **** #define APSR_V_Pos                         28U                                            /*!< APSR
 234:../../../../library/CMSIS/Include/core_cm0plus.h **** #define APSR_V_Msk                         (1UL << APSR_V_Pos)                            /*!< APSR
 235:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 236:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 237:../../../../library/CMSIS/Include/core_cm0plus.h **** /**
 238:../../../../library/CMSIS/Include/core_cm0plus.h ****   \brief  Union type to access the Interrupt Program Status Register (IPSR).
 239:../../../../library/CMSIS/Include/core_cm0plus.h ****  */
 240:../../../../library/CMSIS/Include/core_cm0plus.h **** typedef union
 241:../../../../library/CMSIS/Include/core_cm0plus.h **** {
 242:../../../../library/CMSIS/Include/core_cm0plus.h ****   struct
 243:../../../../library/CMSIS/Include/core_cm0plus.h ****   {
 244:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t ISR:9;                      /*!< bit:  0.. 8  Exception number */
 245:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t _reserved0:23;              /*!< bit:  9..31  Reserved */
 246:../../../../library/CMSIS/Include/core_cm0plus.h ****   } b;                                   /*!< Structure used for bit  access */
 247:../../../../library/CMSIS/Include/core_cm0plus.h ****   uint32_t w;                            /*!< Type      used for word access */
 248:../../../../library/CMSIS/Include/core_cm0plus.h **** } IPSR_Type;
 249:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 250:../../../../library/CMSIS/Include/core_cm0plus.h **** /* IPSR Register Definitions */
 251:../../../../library/CMSIS/Include/core_cm0plus.h **** #define IPSR_ISR_Pos                        0U                                            /*!< IPSR
 252:../../../../library/CMSIS/Include/core_cm0plus.h **** #define IPSR_ISR_Msk                       (0x1FFUL /*<< IPSR_ISR_Pos*/)                  /*!< IPSR
 253:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 254:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 255:../../../../library/CMSIS/Include/core_cm0plus.h **** /**
 256:../../../../library/CMSIS/Include/core_cm0plus.h ****   \brief  Union type to access the Special-Purpose Program Status Registers (xPSR).
 257:../../../../library/CMSIS/Include/core_cm0plus.h ****  */
 258:../../../../library/CMSIS/Include/core_cm0plus.h **** typedef union
 259:../../../../library/CMSIS/Include/core_cm0plus.h **** {
 260:../../../../library/CMSIS/Include/core_cm0plus.h ****   struct
 261:../../../../library/CMSIS/Include/core_cm0plus.h ****   {
 262:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t ISR:9;                      /*!< bit:  0.. 8  Exception number */
 263:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t _reserved0:15;              /*!< bit:  9..23  Reserved */
 264:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t T:1;                        /*!< bit:     24  Thumb bit        (read 0) */
 265:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t _reserved1:3;               /*!< bit: 25..27  Reserved */
 266:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t V:1;                        /*!< bit:     28  Overflow condition code flag */
 267:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t C:1;                        /*!< bit:     29  Carry condition code flag */
 268:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t Z:1;                        /*!< bit:     30  Zero condition code flag */
 269:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t N:1;                        /*!< bit:     31  Negative condition code flag */
 270:../../../../library/CMSIS/Include/core_cm0plus.h ****   } b;                                   /*!< Structure used for bit  access */
 271:../../../../library/CMSIS/Include/core_cm0plus.h ****   uint32_t w;                            /*!< Type      used for word access */
 272:../../../../library/CMSIS/Include/core_cm0plus.h **** } xPSR_Type;
 273:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 274:../../../../library/CMSIS/Include/core_cm0plus.h **** /* xPSR Register Definitions */
 275:../../../../library/CMSIS/Include/core_cm0plus.h **** #define xPSR_N_Pos                         31U                                            /*!< xPSR
 276:../../../../library/CMSIS/Include/core_cm0plus.h **** #define xPSR_N_Msk                         (1UL << xPSR_N_Pos)                            /*!< xPSR
 277:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 278:../../../../library/CMSIS/Include/core_cm0plus.h **** #define xPSR_Z_Pos                         30U                                            /*!< xPSR
 279:../../../../library/CMSIS/Include/core_cm0plus.h **** #define xPSR_Z_Msk                         (1UL << xPSR_Z_Pos)                            /*!< xPSR
 280:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 281:../../../../library/CMSIS/Include/core_cm0plus.h **** #define xPSR_C_Pos                         29U                                            /*!< xPSR
 282:../../../../library/CMSIS/Include/core_cm0plus.h **** #define xPSR_C_Msk                         (1UL << xPSR_C_Pos)                            /*!< xPSR
 283:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 284:../../../../library/CMSIS/Include/core_cm0plus.h **** #define xPSR_V_Pos                         28U                                            /*!< xPSR
 285:../../../../library/CMSIS/Include/core_cm0plus.h **** #define xPSR_V_Msk                         (1UL << xPSR_V_Pos)                            /*!< xPSR
 286:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 287:../../../../library/CMSIS/Include/core_cm0plus.h **** #define xPSR_T_Pos                         24U                                            /*!< xPSR
 288:../../../../library/CMSIS/Include/core_cm0plus.h **** #define xPSR_T_Msk                         (1UL << xPSR_T_Pos)                            /*!< xPSR
 289:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 290:../../../../library/CMSIS/Include/core_cm0plus.h **** #define xPSR_ISR_Pos                        0U                                            /*!< xPSR
 291:../../../../library/CMSIS/Include/core_cm0plus.h **** #define xPSR_ISR_Msk                       (0x1FFUL /*<< xPSR_ISR_Pos*/)                  /*!< xPSR
 292:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 293:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 294:../../../../library/CMSIS/Include/core_cm0plus.h **** /**
 295:../../../../library/CMSIS/Include/core_cm0plus.h ****   \brief  Union type to access the Control Registers (CONTROL).
 296:../../../../library/CMSIS/Include/core_cm0plus.h ****  */
 297:../../../../library/CMSIS/Include/core_cm0plus.h **** typedef union
 298:../../../../library/CMSIS/Include/core_cm0plus.h **** {
 299:../../../../library/CMSIS/Include/core_cm0plus.h ****   struct
 300:../../../../library/CMSIS/Include/core_cm0plus.h ****   {
 301:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t nPRIV:1;                    /*!< bit:      0  Execution privilege in Thread mode */
 302:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t SPSEL:1;                    /*!< bit:      1  Stack to be used */
 303:../../../../library/CMSIS/Include/core_cm0plus.h ****     uint32_t _reserved1:30;              /*!< bit:  2..31  Reserved */
 304:../../../../library/CMSIS/Include/core_cm0plus.h ****   } b;                                   /*!< Structure used for bit  access */
 305:../../../../library/CMSIS/Include/core_cm0plus.h ****   uint32_t w;                            /*!< Type      used for word access */
 306:../../../../library/CMSIS/Include/core_cm0plus.h **** } CONTROL_Type;
