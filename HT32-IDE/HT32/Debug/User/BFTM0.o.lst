 308:../../../../library/CMSIS/Include/core_cm0plus.h **** /* CONTROL Register Definitions */
 309:../../../../library/CMSIS/Include/core_cm0plus.h **** #define CONTROL_SPSEL_Pos                   1U                                            /*!< CONT
 310:../../../../library/CMSIS/Include/core_cm0plus.h **** #define CONTROL_SPSEL_Msk                  (1UL << CONTROL_SPSEL_Pos)                     /*!< CONT
 311:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 312:../../../../library/CMSIS/Include/core_cm0plus.h **** #define CONTROL_nPRIV_Pos                   0U                                            /*!< CONT
 313:../../../../library/CMSIS/Include/core_cm0plus.h **** #define CONTROL_nPRIV_Msk                  (1UL /*<< CONTROL_nPRIV_Pos*/)                 /*!< CONT
 314:../../../../library/CMSIS/Include/core_cm0plus.h **** 
