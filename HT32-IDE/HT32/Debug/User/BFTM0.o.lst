 617:../../../../library/CMSIS/Include/core_cm0plus.h ****   \brief      Macros for use with bit field definitions (xxx_Pos, xxx_Msk).
 618:../../../../library/CMSIS/Include/core_cm0plus.h ****   @{
 619:../../../../library/CMSIS/Include/core_cm0plus.h ****  */
 620:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 621:../../../../library/CMSIS/Include/core_cm0plus.h **** /**
 622:../../../../library/CMSIS/Include/core_cm0plus.h ****   \brief   Mask and shift a bit field value for use in a register bit range.
 623:../../../../library/CMSIS/Include/core_cm0plus.h ****   \param[in] field  Name of the register bit field.
 624:../../../../library/CMSIS/Include/core_cm0plus.h ****   \param[in] value  Value of the bit field. This parameter is interpreted as an uint32_t type.
 625:../../../../library/CMSIS/Include/core_cm0plus.h ****   \return           Masked and shifted value.
 626:../../../../library/CMSIS/Include/core_cm0plus.h **** */
 627:../../../../library/CMSIS/Include/core_cm0plus.h **** #define _VAL2FLD(field, value)    (((uint32_t)(value) << field ## _Pos) & field ## _Msk)
 628:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 629:../../../../library/CMSIS/Include/core_cm0plus.h **** /**
 630:../../../../library/CMSIS/Include/core_cm0plus.h ****   \brief     Mask and shift a register value to extract a bit filed value.
 631:../../../../library/CMSIS/Include/core_cm0plus.h ****   \param[in] field  Name of the register bit field.
 632:../../../../library/CMSIS/Include/core_cm0plus.h ****   \param[in] value  Value of register. This parameter is interpreted as an uint32_t type.
 633:../../../../library/CMSIS/Include/core_cm0plus.h ****   \return           Masked and shifted bit field value.
 634:../../../../library/CMSIS/Include/core_cm0plus.h **** */
 635:../../../../library/CMSIS/Include/core_cm0plus.h **** #define _FLD2VAL(field, value)    (((uint32_t)(value) & field ## _Msk) >> field ## _Pos)
 636:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 637:../../../../library/CMSIS/Include/core_cm0plus.h **** /*@} end of group CMSIS_core_bitfield */
