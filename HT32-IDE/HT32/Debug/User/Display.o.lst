 356:../../../../library/CMSIS/Include/core_cm0plus.h **** {
 357:../../../../library/CMSIS/Include/core_cm0plus.h ****   __IM  uint32_t CPUID;                  /*!< Offset: 0x000 (R/ )  CPUID Base Register */
 358:../../../../library/CMSIS/Include/core_cm0plus.h ****   __IOM uint32_t ICSR;                   /*!< Offset: 0x004 (R/W)  Interrupt Control and State Regi
 359:../../../../library/CMSIS/Include/core_cm0plus.h **** #if defined (__VTOR_PRESENT) && (__VTOR_PRESENT == 1U)
 360:../../../../library/CMSIS/Include/core_cm0plus.h ****   __IOM uint32_t VTOR;                   /*!< Offset: 0x008 (R/W)  Vector Table Offset Register */
 361:../../../../library/CMSIS/Include/core_cm0plus.h **** #else
 362:../../../../library/CMSIS/Include/core_cm0plus.h ****         uint32_t RESERVED0;
 363:../../../../library/CMSIS/Include/core_cm0plus.h **** #endif
 364:../../../../library/CMSIS/Include/core_cm0plus.h ****   __IOM uint32_t AIRCR;                  /*!< Offset: 0x00C (R/W)  Application Interrupt and Reset 
