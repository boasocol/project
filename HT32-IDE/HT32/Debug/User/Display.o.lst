 169:../../../../library/CMSIS/Include/core_cm0plus.h **** #ifdef __cplusplus
 170:../../../../library/CMSIS/Include/core_cm0plus.h ****   #define   __I     volatile             /*!< Defines 'read only' permissions */
 171:../../../../library/CMSIS/Include/core_cm0plus.h **** #else
