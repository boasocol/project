 175:../../../../library/CMSIS/Include/core_cm0plus.h **** #define     __IO    volatile             /*!< Defines 'read / write' permissions */
 176:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 177:../../../../library/CMSIS/Include/core_cm0plus.h **** /* following defines should be used for structure members */
 178:../../../../library/CMSIS/Include/core_cm0plus.h **** #define     __IM     volatile const      /*! Defines 'read only' structure member permissions */
 179:../../../../library/CMSIS/Include/core_cm0plus.h **** #define     __OM     volatile            /*! Defines 'write only' structure member permissions */
 180:../../../../library/CMSIS/Include/core_cm0plus.h **** #define     __IOM    volatile            /*! Defines 'read / write' structure member permissions */
 181:../../../../library/CMSIS/Include/core_cm0plus.h **** 
 182:../../../../library/CMSIS/Include/core_cm0plus.h **** /*@} end of group Cortex-M0+ */
