 331:../../../../library/CMSIS/Include/core_cm0plus.h ****         uint32_t RESERVED0[31U];
 332:../../../../library/CMSIS/Include/core_cm0plus.h ****   __IOM uint32_t ICER[1U];               /*!< Offset: 0x080 (R/W)  Interrupt Clear Enable Register 
 333:../../../../library/CMSIS/Include/core_cm0plus.h ****         uint32_t RESERVED1[31U];
 334:../../../../library/CMSIS/Include/core_cm0plus.h ****   __IOM uint32_t ISPR[1U];               /*!< Offset: 0x100 (R/W)  Interrupt Set Pending Register *
 335:../../../../library/CMSIS/Include/core_cm0plus.h ****         uint32_t RESERVED2[31U];
 336:../../../../library/CMSIS/Include/core_cm0plus.h ****   __IOM uint32_t ICPR[1U];               /*!< Offset: 0x180 (R/W)  Interrupt Clear Pending Register
 337:../../../../library/CMSIS/Include/core_cm0plus.h ****         uint32_t RESERVED3[31U];
 338:../../../../library/CMSIS/Include/core_cm0plus.h ****         uint32_t RESERVED4[64U];
 339:../../../../library/CMSIS/Include/core_cm0plus.h ****   __IOM uint32_t IP[8U];                 /*!< Offset: 0x300 (R/W)  Interrupt Priority Register */
 340:../../../../library/CMSIS/Include/core_cm0plus.h **** }  NVIC_Type;
