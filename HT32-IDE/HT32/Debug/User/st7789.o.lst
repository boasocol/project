 108:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  */
 109:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** void ST7789_Deselect(void)
 110:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** {
 111:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   ST7789_SPI_WaitDone();
 112:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   SPI_SoftwareSELCmd(ST7789_SPI, SPI_SEL_INACTIVE);
 113:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** }
