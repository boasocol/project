  30:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** /**
  31:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  * @brief  软件延时函数（使用BFTM0精确延时）
  32:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  * @note   基于BFTM0定时器，每1ms中断一次，全局变量bftm0_ct递增
  33:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  * @param  ms: 延时毫秒数
  34:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  * @retval 无
  35:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  */
  36:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** void Delay(u32 ms)
  37:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** {
  38:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   vu32 target = bftm0_ct + ms;
  39:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   while (bftm0_ct < target);
  40:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** }
  41:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** 
  42:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** //-----------------------------------------------------------------------------
  43:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** /**
  44:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  * @brief  SPI发送一个字节（带D/C位）
  45:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  * @note   JT60436-01屏幕使用SPI3W（三线SPI）模式，不需要独立DC引脚
  46:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  *         通过数据最高位(D8)区分命令/数据：
  47:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  *         - D8=0 (dc_bit=0): 命令
  48:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  *         - D8=1 (dc_bit=1): 数据
  49:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  *         SPI配置为9位数据宽度，其中D8为DC位，D0-D7为实际数据
  50:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  * @param  data: 要发送的8位数据（低8位）
  51:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  * @param  dc_bit: D/C位（0=命令，1=数据）
  52:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  * @retval 0=成功，1=超时
  53:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  */
  54:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** static u8 ST7789_SPI_SendByte(u8 data, u8 dc_bit)
  55:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** {
  56:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   u32 timeout = 100000;
  57:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   while ((SPI_GetFlagStatus(ST7789_SPI, SPI_FLAG_TXBE) == RESET) && (timeout--));
  58:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   if (timeout == 0) { return 1; }
  59:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   
  60:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   SPI_SendData(ST7789_SPI, (dc_bit << 8) | data);
  61:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   
  62:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   timeout = 100000;
  63:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   while ((SPI_GetFlagStatus(ST7789_SPI, SPI_FLAG_RXBNE) == RESET) && (timeout--));
  64:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   if (timeout == 0) { return 1; }
  65:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   
  66:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   (void)SPI_ReceiveData(ST7789_SPI);
  67:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   return 0;
  68:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** }
  69:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** 
  70:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** //-----------------------------------------------------------------------------
  71:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** /**
  72:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  * @brief  等待SPI发送完成
  73:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  * @note   等待TXE（发送完成）和BUSY（总线忙）标志，确保数据完全发送
  74:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  *         必须在每次SPI传输结束后调用，保证CS拉高时数据已发送完毕
  75:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  * @retval 0=成功，1=超时
  76:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  */
  77:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** static u8 ST7789_SPI_WaitDone(void)
  78:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** {
  79:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   u32 timeout = 100000;
  80:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   while ((SPI_GetFlagStatus(ST7789_SPI, SPI_FLAG_TXE) == RESET) && (timeout--));
  81:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   if (timeout == 0) { return 1; }
  82:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   
  83:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   timeout = 100000;
  84:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   while ((SPI_GetFlagStatus(ST7789_SPI, SPI_FLAG_BUSY) != RESET) && (timeout--));
  85:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   if (timeout == 0) { return 1; }
  86:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   
  87:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   return 0;
  88:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** }
  89:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** 
  90:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** //-----------------------------------------------------------------------------
  91:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** /**
  92:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  * @brief  拉低CS，开始一次SPI传输事务
  93:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  * @note   ST7789的SPI协议要求：一条命令及其所有参数必须在同一次CS低电平�
  94:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  *         因此命令与参数发送函数本身不再操作CS，由本函数和ST7789_Deselect()
  95:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  *         使用SPI软件片选功能，通过SPI_SoftwareSELCmd()控制PB2引脚
  96:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  * @retval 无
  97:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****  */
  98:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** void ST7789_Select(void)
  99:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** {
 100:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c ****   SPI_SoftwareSELCmd(ST7789_SPI, SPI_SEL_ACTIVE);
 101:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** }
 102:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\st7789.c **** 
