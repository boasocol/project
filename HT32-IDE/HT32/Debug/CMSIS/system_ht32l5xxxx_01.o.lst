 102:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //
 103:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //    <h> SystemCoreClock Configuration (CK_AHB)
