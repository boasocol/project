  72:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //    <e3> Enable Low Speed External Crystal Oscillator (LSE)
  73:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //          <i> Default LSE = DISABLE
  74:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //       <q13> Enable Waiting LSE Clock Ready
  75:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <i> Default Waiting LSE Clock Ready = ENABLE
  76:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //    </e>
  77:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //
  78:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //    <e4> Enable PLL
  79:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <i> Default PLL = DISABLE
  80:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <i> PLL Out = (((HSE or HSI) / SRC_DIV) x NF2 ) / NO2
  81:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //        <o5>  PLL Clock Source
  82:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <0=> CK_HSE
  83:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <1=> CK_HSI
  84:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <i> Default PLL clock source = CK_HSI
  85:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <i> PLL source clock must be in the range of 4 MHz to 16 MHz
  86:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //        <o6>  PLL Clock Source Divider (SRC_DIV)
  87:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <0=> 1
  88:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <1=> 2
  89:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <i> PLL input clock = PLL Clock Source / (SRC_DIV)
  90:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //        <o7>  PLL Feedback Clock Divider (NF2): 1 ~ 16
  91:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <1-16:1>
  92:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <i> PLL feedback clock = PLL input clock x NF2
  93:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <i> PLL feedback clock must be in the range of 24 MHz to 48 MHz
  94:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //        <o8>  PLL Output Clock Divider (NO2)
  95:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <0=> 1
  96:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <1=> 2
  97:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <2=> 4
  98:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <3=> 8
  99:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <i> PLL output clock = PLL feedback clock / NO2
 100:C:/Users/q3112/Desktop/HT/4/HT32L52231_QFN32/project\system_ht32l5xxxx_01.c **** //                <i> PLL output clock must be in the range of 4 MHz to 48 MHz
